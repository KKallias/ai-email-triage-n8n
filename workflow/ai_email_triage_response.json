    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyse the incoming customer email.\n\nExtract these fields:\n\nEmail: sender email address\nSubject: email subject\nIssue: short summary of the customer's issue\nCategory: choose one of Support, Billing, Refund, Sales, General\nSentiment: choose one of Positive, Neutral, Negative\nDate: date the email was received\nReply Needed: choose Yes when the sender asks a question, requests help, reports a problem, requests information, or expects an action. Choose No when the email is only a thank-you, acknowledgement, confirmation with no question, spam, or does not require further action.\n\nUse only information from the email.\nDo not invent missing information.\n\nEmail to analyse:\n\nFrom: {{ $json.From }}\nSubject: {{ $json.Subject }}\nMessage: {{ $json.snippet }}\nDate: {{ $json.internalDate }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You analyse customer emails and return structured information.\n\nUse only the information provided in the email.\nDo not invent information.\nKeep the Issue summary short and clear."
        }
